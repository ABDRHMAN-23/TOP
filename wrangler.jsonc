{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aqarflow-ai1",
  "keep_vars": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aqarflow-ai1"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://djpfjbjjybpquvzacmtj.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_TkjtLbzWTqXlE18tcvGpow_XFxdTvmz",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_TkjtLbzWTqXlE18tcvGpow_XFxdTvmz",
    "NEXT_PUBLIC_DEMO_MODE": "false",
    "CLINICAL_AUDIO_BUCKET": "clinical-audio-private",
    "GEMINI_MODEL": "gemini-2.5-flash"
  }
}
