NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never expose this in the browser.
SUPABASE_SECRET_KEY=

# Meta WhatsApp Cloud API — server-side secrets only.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
# cloud_api (default) or coexistence (WhatsApp Business App + Cloud API; requires a compatible Meta config).
META_WHATSAPP_SIGNUP_MODE=cloud_api
META_WEBHOOK_VERIFY_TOKEN=
# Generate a random 32-byte key, Base64-encode it, and store it as a server secret only.
META_TOKEN_ENCRYPTION_KEY=
# Public IDs consumed by the Meta Embedded Signup UI; never put app secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=

# Gemini AI — server only.
AQARFLOW_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_MODEL=gemini-3.8-flash

# Legacy providers are no longer used by QUVOTO.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=
# GEMMA_API_URL=
# GEMMA_API_KEY=
# GEMMA_MODEL=

PRICE_INTELLIGENCE_API_URL=
PRICE_INTELLIGENCE_API_KEY=

# Lemon Squeezy — server only except the public store/variant IDs if you choose to expose them.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STARTER_VARIANT_ID=
LEMON_SQUEEZY_PRO_VARIANT_ID=
LEMON_SQUEEZY_TEAM_VARIANT_ID=
LEMON_SQUEEZY_STARTER_ANNUAL_VARIANT_ID=
LEMON_SQUEEZY_PRO_ANNUAL_VARIANT_ID=
LEMON_SQUEEZY_TEAM_ANNUAL_VARIANT_ID=

# Legal consent signing — server only; generate a random secret of at least 32 characters.
QUVOTO_LEGAL_CONSENT_SECRET=

# Super Admin — use the stable user ID when possible. Email is a fallback.
QUVOTO_SUPER_ADMIN_USER_ID=
QUVOTO_SUPER_ADMIN_EMAIL=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@quvoto.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
