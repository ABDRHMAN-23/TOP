NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never expose this in the browser.
SUPABASE_SECRET_KEY=

# Optional transcription provider.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# VoiceQuote extraction engine — Gemma 4 31B.
# Point this at your self-hosted Gemma 4 31B endpoint.
GEMMA_API_URL=
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-31b